# ============================================
# VAULT CONFIGURATION (Optional - remove when Vault is enabled)
# ============================================
# When Vault is enabled, sensitive values come from Vault
# When disabled, the fallback values below are used
VAULT_ENABLED=false
# VAULT_ADDR=http://vault:8200
# VAULT_ROLE_ID=vault_role_id
# VAULT_SECRET_ID=vault_secret_id
# ============================================

# ============================================
# SENSITIVE CONFIG (Falls back to these when Vault is disabled) 
#     
#       !!! TO BE REMOVED WHEN VAULT IS ENABLED !!!
#
# ============================================
DATABASE_URL=postgresql://user:root123@postgres:5432/database

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
SECRET_KEY=prod-secret-key-change-this-in-production
JWT_SECRET_KEY=jwt-secret-key-change-this-in-production
WIREGUARD_FIELD_ENCRYPTION_KEY=wireguard_secret_key

DEFAULT_ADMIN_PASSWORD=admin123 #

# Proxmox API URL
PROXMOX_URL=https://10.0.0.51:8006 # Proxmox node ip
PROXMOX_USERNAME=root@pam!packer-builder
PROXMOX_TOKEN=proxmox_user_token
PROXMOX_NODE=pve

# OPNSENSE PROVISIONING CONFIGURATION

# OPNsense Template ID (VM to clone for default firewall)
OPNSENSE_TEMPLATE_ID=9000
# Generate this in OPNsense: System -> Access -> Users -> provisioner -> API Keys
# Format: just the key string (not username!keyId)
OPNSENSE_BOOTSTRAP_KEY=opnsense_bootstrap_key

# OPNsense Bootstrap API Secret
OPNSENSE_BOOTSTRAP_SECRET=opnsense_bootstrap_secret

# ============================================



# ============================================
# NON-SENSITIVE CONFIG
# ============================================

# Celery Configuration
CELERY_CONCURRENCY=2

# Database Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO_SQL=false
REQUEST_MAX_BODY_SIZE=10485760

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development # Or production

# Default Admin
CREATE_DEFAULT_ADMIN=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@cloud.com

# Registration Control
ALLOW_REGISTRATION=true
ALLOWED_EMAIL_DOMAINS=

# vSphere Configuration
VCENTER_SERVER=vcenter.cloud.local
VCENTER_USER=administrator@vsphere.local
VCENTER_DATACENTER=DC
VCENTER_CLUSTER=Cluster
VCENTER_DATASTORE=datastore1
VCENTER_NETWORK="VM Network"

# Application
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://localhost:5173"]

# Terraform
TERRAFORM_TEMP_DIR=

# Default VM Image
DEFAULT_VM_IMAGE=nginx:latest

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_PERIOD_SECONDS=60
RATE_LIMIT_ADMIN_REQUESTS=10
RATE_LIMIT_ADMIN_PERIOD_SECONDS=60
RATE_LIMIT_FAIL_CLOSED=true

# Testing
TESTING=false

# PGAdmin
PGADMIN_EMAIL=admin@cloud.com
# ============================================